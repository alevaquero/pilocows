# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM — OPI (Octal) PSRAM on WT32-S3-WROVER
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# USB Serial/JTAG (ESP32-S3 native USB for flashing/monitor)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# BLE — NimBLE (lighter than Bluedroid)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n

# NVS — for scan storage and settings
CONFIG_NVS_ASSERT_ERROR_CHECK=n

# SPIFFS — for larger scan log
CONFIG_SPIFFS_MAX_PARTITIONS=1
CONFIG_SPIFFS_OBJ_NAME_LEN=64

# LCD — increase DMA buffer for 8080 parallel
CONFIG_LCD_PANEL_IO_FORMAT_BUF_SIZE=32768

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# Log level (set to Info for production, Debug during dev)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL — configured via idf_component.yml + Kconfig
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_COLOR_SCREEN_TRANSP=n
